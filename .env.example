# This file is a template for the .env file that will be used in the project.
# The .env file is used to store environment variables that will be used in the project.

# ----------------------------------------
# NODE ENVIRONMENT
# ----------------------------------------

# The port that the server will run on
PORT=3000
# The environment that the server is running in
NODE_ENV=development

# ----------------------------------------
# MONGODB CONFIGURATION
# ----------------------------------------

# The MongoDB connection string
DB_URL=mongodb://localhost:27017/mydatabase

# ----------------------------------------
# APPLICATION URL
# ----------------------------------------

# Base URL of the running application. Used to build absolute links (emails, redirects, etc.).
# For local development use http://localhost:3000 (or the PORT you run the app on).
# In production set it to your public URL, e.g. https://app.example.com
APP_URL=http://localhost:3000

# ----------------------------------------
# FRONT PUBLIC URL
# ----------------------------------------

# The public URL of the front-end application
FRONT_PUBLIC_URL=http://localhost:4200

# ----------------------------------------
# CORS CONFIGURATION
# ----------------------------------------

# The allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://example.com

# ----------------------------------------
# DISCORD WEBHOOK CONFIGURATION
# ----------------------------------------

# The Discord webhook URL for sending notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ----------------------------------------
# EMAIL NOTIFICATIONS CONFIGURATION
# ----------------------------------------

# The email address to send notifications from
USER_NOTIFICATIONS=myemail@example.com
# The password for the email account
PASSWORD_NOTIFICATIONS=mypassword

# ----------------------------------------
# Caching Configuration
# ----------------------------------------
# Redis host for caching
REDIS_HOST=localhost
# Redis port for caching
REDIS_PORT=6379
# Redis password for caching (if applicable)
REDIS_PASSWORD=your_redis_password
# Redis admin username (keys visualization and management)
REDIS_ADMIN_USER=your_redis_admin_username
# Redis admin password (keys visualization and management)
REDIS_ADMIN_PASSWORD=your_redis_admin_password

# ----------------------------------------
# DEFAULT USER CREDENTIALS
# ----------------------------------------

# The default first name for the admin user
DEFAULT_USER_FIRST_NAME=your_default_admin_first_name
# The default last name for the admin user
DEFAULT_USER_LAST_NAME=your_default_admin_last_name
# The default phone number for the admin user
DEFAULT_USER_PHONE=your_default_admin_phone
# The default document for the admin user
DEFAULT_USER_DOCUMENT=your_default_admin_document
# The default document type for the admin user
DEFAULT_USER_DOCUMENT_TYPE=your_default_admin_document_type
# The default email for the admin user
DEFAULT_USER_EMAIL=your_default_admin_email
# The default password for the admin user
DEFAULT_USER_PASSWORD=your_default_admin_password
